# Copiem para .env.local e preencham. Nunca versionem o .env.local.

# PostgreSQL (Neon ou qualquer Postgres 13+). Depois rodem: npm run db:migrate
DATABASE_URL=

# IA do estúdio criativo e da organização das contribuições (Claude, da Anthropic). Opcional:
# sem a chave, o estúdio funciona em modo demonstrativo, identificado na tela.
ANTHROPIC_API_KEY=

# Envio de e-mails de recuperação de senha pela Resend. Opcional: sem configuração,
# o link aparece no terminal do servidor em desenvolvimento.
RESEND_API_KEY=
EMAIL_FROM=
