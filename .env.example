# Copiem para .env.local e preencham. Nunca versionem o .env.local.

# PostgreSQL (Neon ou qualquer Postgres 13+). Depois rodem: npm run db:migrate
DATABASE_URL=

# IA do estúdio criativo (opcional e gratuita). Chave do Google Gemini, sem cartão:
# https://aistudio.google.com/apikey
# Sem a chave, o estúdio funciona em modo demonstrativo, identificado na tela.
AI_API_KEY=
# Opcional: outro provedor compatível com a API da OpenAI (padrão: Gemini 3.1 Flash-Lite).
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1/   AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1/     AI_MODEL=<um modelo com sufixo :free>
AI_BASE_URL=
AI_MODEL=
# Modelos reserva, separados por vírgula, usados quando o principal está sobrecarregado ou sem cota
# (padrão no Gemini: gemini-flash-latest).
AI_FALLBACK_MODELS=
# Coloquem false para não enviar textos de convidados à IA (sugestão de capítulo desligada).
AI_CLASSIFY_CONTRIBUTIONS=

# Envio de e-mails de recuperação de senha pela Resend. Opcional: sem configuração,
# o link aparece no terminal do servidor em desenvolvimento.
RESEND_API_KEY=
EMAIL_FROM=
